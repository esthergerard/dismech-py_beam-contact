NONCENTRAL_X_END_NEG, 1, 1, -3.75e-3
NONCENTRAL_X_END_NEG, 2, 3, 0.
NONCENTRAL_X_END_POS, 1, 1,  3.75e-3
NONCENTRAL_X_END_POS, 2, 3, 0.
X_BEAM_2_END_POS,     1, 1, 3.0e-2
X_BEAM_2_END_POS,     2, 3, 0.
